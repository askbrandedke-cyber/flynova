# Public URL of the deployed site (used for canonical URLs, sitemap and Open Graph).
NEXT_PUBLIC_SITE_URL=https://flynova-kappa.vercel.app

# --- Email notifications (optional, recommended) -----------------------------
# Create a free account at https://resend.com, verify your domain, create an API key.
RESEND_API_KEY=
# Where booking requests are delivered (comma-separated for several inboxes).
INQUIRY_TO_EMAIL=flynova211@gmail.com
# Sender address on a domain verified in Resend, e.g. "Flynova Website <bookings@yourdomain.com>".
INQUIRY_FROM_EMAIL=

# --- Webhook / database / CRM (optional) --------------------------------------
# Every validated inquiry is POSTed here as JSON (Zapier, Make, n8n, Google Apps Script,
# Airtable automation, Supabase Edge Function, your own API...).
INQUIRY_WEBHOOK_URL=
# Sent as the X-Flynova-Secret header so the receiver can verify the request.
INQUIRY_WEBHOOK_SECRET=
